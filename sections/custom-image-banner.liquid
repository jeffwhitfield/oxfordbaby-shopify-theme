{% comment %}
  Custom Image Banner
  Save this file as: sections/custom-image-banner.liquid

  Settings:
  - Background image
  - Separate desktop and mobile height
  - Optional overlay with color + opacity
  - Optional link on the whole section, same tab or new tab
{% endcomment %}

{%- liquid
  assign image = section.settings.background_image
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign wrapper_tag = 'div'
  if section.settings.link != blank
    assign wrapper_tag = 'a'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cib {
    position: relative;
    display: block;
    width: 100%;
    height: {{ section.settings.height_mobile }}px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    {%- unless section.settings.full_width %}
    max-width: {{ section.settings.max_width }}px;
    margin-left: auto;
    margin-right: auto;
    {%- endunless %}
  }

  #shopify-section-{{ section.id }} .cib__media,
  #shopify-section-{{ section.id }} .cib__media svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    display: block;
  }

  #shopify-section-{{ section.id }} .cib__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ overlay_alpha }};
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} a.cib:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .cib {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cib {
      height: {{ section.settings.height_desktop }}px;
    }
  }
{%- endstyle -%}

<{{ wrapper_tag }}
  class="cib"
  {%- if wrapper_tag == 'a' %}
    href="{{ section.settings.link }}"
    {%- if section.settings.open_new_tab %}
    target="_blank" rel="noopener noreferrer"
    {%- endif %}
    aria-label="{{ image.alt | default: shop.name | escape }}"
  {%- endif %}
>
  {%- if image != blank -%}
    <img
      class="cib__media"
      src="{{ image | image_url: width: 1500 }}"
      srcset="
        {{ image | image_url: width: 375 }} 375w,
        {{ image | image_url: width: 750 }} 750w,
        {{ image | image_url: width: 1100 }} 1100w,
        {{ image | image_url: width: 1500 }} 1500w,
        {{ image | image_url: width: 2000 }} 2000w
      "
      sizes="100vw"
      width="{{ image.width }}"
      height="{{ image.height }}"
      alt="{{ image.alt | escape }}"
      loading="{% if section.settings.lazy_load %}lazy{% else %}eager{% endif %}"
      fetchpriority="{% if section.settings.lazy_load %}auto{% else %}high{% endif %}"
    >
  {%- else -%}
    <div class="cib__media">
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    </div>
  {%- endif -%}

  {%- if section.settings.show_overlay -%}
    <div class="cib__overlay"></div>
  {%- endif -%}
</{{ wrapper_tag }}>

{% schema %}
{
  "name": "Custom Image Banner",
  "tag": "section",
  "class": "section-custom-image-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "checkbox",
      "id": "lazy_load",
      "label": "Lazy load image",
      "info": "Turn this off if the section is the first thing on the page.",
      "default": true
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Section link",
      "info": "Leave empty to make the section non clickable."
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open in a new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "info": "Only applies when Full width is off.",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom Image Banner"
    }
  ]
}
{% endschema %}
